function main(args: string[]): int {
    var i = 0;
    var sum = 0;


    while (i < 10) {
        i = i + 1;


        if (i == 3 or i == 5) {
            continue;
        }


        if (i >= 8 and not (i == 9)) {
            break;
        }


        print(i);
        sum = sum + i;
    }


    print(sum);
    return 0;
}